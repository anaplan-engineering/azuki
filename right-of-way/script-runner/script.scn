// Example verifiable scenario for the right-of-way system.
verifiableScenario {
    given {
        thereIsANewAirspaceWithAircraft("UK", 5U)
    }
    then {
        // Howw to access the created aircrafts name?
        hasRightOfWay("UK", "a0", "a1")
        hasRightOfWay("UK", "a1", "a2")
        hasRightOfWay("UK", "a2", "a3")
        hasRightOfWay("UK", "a3", "a4")
        hasRightOfWay("UK", "a4", "a5")
    }
}
