oracleScenario {
    given {
        thereIsANewGame("gameA")
    }

    whenever {}

    generate {
        addMoves("gameA")
    }

    verify {
        forAll({ getPositions("gameA") }) { pos ->
            gameHasToken("gameA", pos.col to pos.row)
        }

        forAll({ getPlayOrder("gameA") }) { player ->
            forAll({ getPositions("gameA") }) { pos ->
                playerCanPlaceToken("gameA", player, pos.col to pos.row)
            }
        }
    }
}

