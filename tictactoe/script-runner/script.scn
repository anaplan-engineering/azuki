oracleScenario {
    given {
        thereIsANewGame("gameA")
    }

    whenever {}

    generate {
        addMoves("gameA", (1..9), GenerateTurns.InOrder, GeneratePositions.RandomWalk)
    }

    verify {
        forAll(
            { getPositions("gameA")},
            { pos -> gameHasToken("gameA", pos) }
        )
    }
}

