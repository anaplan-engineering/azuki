verifiableScenario {
    given {
        thereIsAGraph("graphA") {
            edge("a", "b")
            edge("b", "c")
            edge("a", "d")
            edge("d", "e")
            edge("e", "c")
        }
    }
    then {
        hasShortestPath("graphA", from = "a", to = "c", path = arrayOf("a", "b", "c"))
    }
}
